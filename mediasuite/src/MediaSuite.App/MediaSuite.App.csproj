<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MediaSuite.App</RootNamespace>
    <AssemblyName>MediaSuite</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>MediaSuite desktop shell (WPF).</Description>
    <ApplicationIcon>Assets\MediaSuite.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WPF SDK's implicit usings drop System.IO, which the plain net8.0 set
         includes. Every module here deals in file paths, so put it back. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaSuite.Core\MediaSuite.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationIcon above sets the exe's own Win32 icon (Explorer, shortcuts,
         Alt-Tab); this makes the same file available to MainWindow.xaml's Icon=
         property too, so the title bar and taskbar match instead of falling back to
         WPF's default. -->
    <Resource Include="Assets\MediaSuite.ico" />
  </ItemGroup>

</Project>
