# =============================================================================
#  Income Orchestrator — credentials & configuration
# =============================================================================
#
#  HOW TO USE
#    1. Copy this file:            cp .env.example .env
#    2. Fill in the values you have (leave the rest blank for now).
#    3. Lock it down:              chmod 600 .env
#
#  `.env` is git-ignored and will NEVER be committed. Only THIS example file
#  (with no real secrets) lives in the repo. No script hardcodes a key —
#  everything reads from here via `orchestrator.config`.
#
#  You do NOT need every key to start. Each program only requires the keys
#  for the services it actually uses.
# =============================================================================

# --- Core / shared -----------------------------------------------------------
# Used by any module that calls Claude (drafting listings, product copy, etc.)
# Get one at: https://console.anthropic.com/  -> API Keys
ANTHROPIC_API_KEY=

# Where the dashboard listens. Loopback only by default (not exposed to LAN).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# Optional: get a push notification whenever ANY module flags something for
# your review, instead of only finding out by opening the dashboard. Works
# with a Slack incoming webhook, a Discord incoming webhook, or most other
# generic webhook receivers. WHILE IT'S BLANK, nothing is sent — this is
# entirely opt-in.
REVIEW_NOTIFY_WEBHOOK_URL=
REVIEW_NOTIFY_FORMAT=generic  # generic|slack|discord

# --- (1) Stock asset licensing ----------------------------------------------
# Metadata drafting (title/description/keywords) uses ANTHROPIC_API_KEY (top
# of this file). WHILE IT'S BLANK the module stays idle and does nothing.
# Neither marketplace exposes a public contributor API to upload against, so
# these two are not used yet (see modules/stock_licensing/README.md).
SHUTTERSTOCK_API_TOKEN=
ADOBE_STOCK_API_KEY=

# Behaviour (all optional — these are the defaults).
STOCK_LICENSING_MODEL=claude-3-5-haiku-20241022  # small/fast model for keywording
STOCK_LICENSING_MAX_TOKENS=500      # max tokens per draft
STOCK_LICENSING_MAX_PER_RUN=5       # max assets keyworded per run
# Assets are NOT read from .env — see data/stock_assets.json, documented in
# modules/stock_licensing/README.md.

# --- (2) E-commerce / dropshipping ------------------------------------------
# Shopify Admin API: create a custom app in your store admin -> Apps ->
# "Develop apps" -> API credentials. WHILE THESE ARE BLANK the module stays
# idle and does nothing, so it can never touch a store by accident.
SHOPIFY_STORE_URL=
SHOPIFY_ADMIN_API_TOKEN=
# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Behaviour (all optional — these are the defaults).
ECOMMERCE_API_VERSION=2024-01           # Shopify Admin API version
ECOMMERCE_MAX_ORDERS_PER_RUN=25         # orders fetched/processed per run
ECOMMERCE_HIGH_QUANTITY_THRESHOLD=10    # line-item qty that triggers a review flag
ECOMMERCE_MIN_MARGIN_TO_AUTO_LOG=0      # orders below this margin (USD) get flagged
# Supplier costs are NOT read from .env — see data/product_costs.json,
# documented in modules/ecommerce_dropshipping/README.md.

# --- (3) Deal-alert bot ------------------------------------------------------
# Where the bot posts. Create a Discord webhook (see modules/deal_alert_bot/
# README.md) and paste the URL here. WHILE THIS IS BLANK the bot stays in
# dry-run no matter what, so it can never post by accident.
DISCORD_WEBHOOK_URL=

# Behaviour (all optional — these are the defaults). CheapShark needs no key.
DEAL_ALERT_DRY_RUN=true          # true = log only; set to false to post for real
DEAL_MIN_SAVINGS=50              # minimum discount % to qualify
DEAL_MAX_PRICE=                  # only deals at/below this sale price (USD); blank = no cap
DEAL_REQUIRE_HISTORIC_LOW=false  # true = only alert on all-time-low prices
DEAL_STORE_IDS=1                 # CheapShark store IDs, comma-separated (1 = Steam)
DEAL_PAGE_SIZE=60                # deals pulled per store per run (max 60)
DEAL_MAX_POSTS_PER_RUN=5         # cap alerts per run so the channel isn't flooded

# Affiliate link wrapper. Leave blank until your affiliate program is approved.
# Must contain {deal_url}; e.g. https://partner.example/r?u={deal_url}&id=YOURID
DEAL_AFFILIATE_LINK_TEMPLATE=

# (Optional alternative channel — not used by the current bot, kept for later.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AMAZON_AFFILIATE_TAG=

# --- (4) Digital product creation -------------------------------------------
# Copy drafting uses ANTHROPIC_API_KEY (top of this file). WHILE IT'S BLANK
# the module stays idle and does nothing.
# Etsy: https://www.etsy.com/developers/  (create an app for the keystring)
# Not used yet — publishing isn't built (see modules/digital_products/README.md).
ETSY_API_KEY=
ETSY_SHOP_ID=
GUMROAD_ACCESS_TOKEN=

# Behaviour (all optional — these are the defaults).
DIGITAL_PRODUCTS_MODEL=claude-3-5-haiku-20241022  # small/fast model for copy
DIGITAL_PRODUCTS_MAX_TOKENS=700     # max tokens per draft
DIGITAL_PRODUCTS_MAX_PER_RUN=5      # max briefs drafted per run
# Briefs are NOT read from .env — see data/product_briefs.json, documented
# in modules/digital_products/README.md.

# --- (5) Micro-SaaS tool -----------------------------------------------------
# Reuse STRIPE_SECRET_KEY above for billing. WHILE IT'S BLANK, and
# SAAS_HEALTH_URL below is also blank, the module stays idle and does nothing.
SAAS_HEALTH_URL=
SAAS_DATABASE_URL=
SAAS_JWT_SECRET=

# Behaviour (all optional — these are the defaults).
MICRO_SAAS_HEALTH_TIMEOUT=10        # seconds before the health check times out
MICRO_SAAS_SUB_LIMIT=100            # max active subscriptions fetched per run
MICRO_SAAS_CHARGE_LIMIT=100         # max charges fetched per run
MICRO_SAAS_LOOKBACK_HOURS=24        # first-run-ever charge lookback window
MICRO_SAAS_HIGH_CHURN_THRESHOLD=3   # churned subs in one run that trigger a flag
