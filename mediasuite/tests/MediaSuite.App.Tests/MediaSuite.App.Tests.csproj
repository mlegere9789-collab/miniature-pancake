<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches MediaSuite.App's own TargetFramework exactly (net8.0-windows) so the
         ProjectReference below is an unambiguous, same-TFM reference. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MediaSuite.App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- SingleInstanceGuard alone needed nothing WPF-specific, but JobRowViewModel's
         constructor takes a real System.Windows.Threading.Dispatcher, and its own
         computed properties are exactly what a real user notices regress first — worth
         testing directly rather than only through SingleInstanceGuard's plain OS-primitive
         surface. UseWPF pulls in the actual WindowsDesktop shared framework reference
         (WindowsBase/PresentationCore/PresentationFramework) this project now needs. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MediaSuite.App\MediaSuite.App.csproj" />
  </ItemGroup>

</Project>
