<UserControl x:Class="MediaSuite.App.Controls.DropZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             AllowDrop="True"
             Focusable="True"
             MinHeight="180">

    <Border x:Name="Surface"
            Background="{DynamicResource Brush.DropZone.Background}"
            BorderBrush="{DynamicResource Brush.DropZone.Border}"
            BorderThickness="1.5"
            CornerRadius="12"
            Cursor="Hand"
            SnapsToDevicePixels="True">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <TextBlock Text="&#xE898;"
                       FontFamily="{DynamicResource Font.Icons}"
                       FontSize="32"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Text="{Binding Prompt, ElementName=Root}"
                       Style="{DynamicResource Text.Heading}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,12,0,0" />
            <TextBlock Text="{Binding Hint, ElementName=Root}"
                       Style="{DynamicResource Text.Secondary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,6,0,0" />
            <Button Content="Browse files…"
                    Style="{DynamicResource Button.Secondary}"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    Click="OnBrowseClick" />
        </StackPanel>
    </Border>
</UserControl>
