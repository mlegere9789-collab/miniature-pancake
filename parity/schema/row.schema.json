{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dino 8 Parity Register row",
  "type": "object",
  "required": ["id", "program", "statement", "source", "target", "factory", "domain", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^D8-[A-Z0-9]{2,8}-[A-Z0-9]{2,8}-[0-9]{4}$"},
    "program": {"type": "array", "minItems": 1, "items": {"enum": ["rhino", "grasshopper", "archicad", "sketchup", "forma", "revit", "blender", "autocad"]}},
    "statement": {"type": "string", "minLength": 10},
    "source": {"type": "object", "required": ["kind", "ref", "doc"], "additionalProperties": false,
      "properties": {"kind": {"enum": ["command", "operator", "node", "component", "tool", "feature", "setting", "modifier", "constraint", "editor"]},
                     "ref": {"type": "string"}, "doc": {"type": "string"}}},
    "tier_now": {"enum": ["None", "Basic", "Partial", "Strong", "Best"], "default": "None"},
    "target": {"enum": ["Strong", "Best"]},
    "superiority": {"type": "string"},
    "acceptance": {"type": "array", "items": {"type": "object", "required": ["test_id"], "properties": {"test_id": {"type": "string"}, "corpus": {"type": "string"}, "tolerance": {"type": "object"}}}},
    "budget_ref": {"type": ["string", "null"]},
    "links": {"type": "object", "properties": {"pain_points": {"type": "array", "items": {"type": "integer"}}, "wishes": {"type": "array", "items": {"type": "integer"}}}},
    "factory": {"enum": ["kernel-geometry", "mesh-subd-sculpt", "direct-modeling", "flow", "bim-arch", "bim-struct-mep", "drafting-docs", "cad-2d", "render-anim", "simulation", "analysis-site", "interop-migration", "collab-cloud", "ux-access-i18n", "scripting-api-ai", "performance"]},
    "domain": {"type": "string"},
    "alias_of": {"type": ["string", "null"]},
    "status": {"enum": ["open", "in_progress", "verified"]},
    "evidence": {"type": ["object", "null"]},
    "notes": {"type": "string"}
  }
}
