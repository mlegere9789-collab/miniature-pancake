<UserControl x:Class="MediaSuite.App.Views.ModulePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MediaSuite.App.Controls"
             xmlns:converters="clr-namespace:MediaSuite.App.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,24">
        <StackPanel>

            <TextBlock Text="{Binding Headline}" Style="{DynamicResource Text.Display}" />
            <TextBlock Text="{Binding Description}"
                       Style="{DynamicResource Text.Secondary}"
                       MaxWidth="820"
                       HorizontalAlignment="Left"
                       Margin="0,6,0,0" />

            <controls:DropZone Prompt="{Binding DropPrompt}"
                               Hint="{Binding DropHint}"
                               FilesDroppedCommand="{Binding AddFilesCommand}"
                               Margin="0,20,0,0" />

            <!-- Staged files. The queue itself arrives in build step 3; until then this
                 shows exactly what would be handed to it. -->
            <Border Style="{DynamicResource Card}"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Staged files" Style="{DynamicResource Text.Heading}" />
                            <TextBlock Text="{Binding StagedSummary}"
                                       Style="{DynamicResource Text.Secondary}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Clear"
                                Style="{DynamicResource Button.Secondary}"
                                Command="{Binding ClearFilesCommand}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <ListBox ItemsSource="{Binding StagedFiles}"
                             Style="{DynamicResource FileList}"
                             MaxHeight="220"
                             Margin="0,12,0,0" />

                    <TextBlock Text="Job queue, progress and cancel arrive in the next build step."
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- What this page will offer, straight from the feature catalogue -->
            <ItemsControl ItemsSource="{Binding FeatureGroups}" Margin="0,24,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.Heading}" />
                                <TextBlock Text="{Binding CountLabel}"
                                           Style="{DynamicResource Text.Caption}"
                                           VerticalAlignment="Center"
                                           Margin="10,2,0,0" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Features}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource Card}"
                                                Width="268"
                                                Padding="14"
                                                Margin="0,0,12,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{DynamicResource Text.Body}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{DynamicResource Text.Secondary}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0" />
                                                <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,10,0,0">
                                                    <Run Text="Build step" />
                                                    <Run Text="{Binding BuildStep, Mode=OneWay}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding OperationId, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
