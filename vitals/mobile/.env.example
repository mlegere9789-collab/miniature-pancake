# Backend URL the app talks to. Use your machine's LAN IP (not localhost)
# when testing on a physical device via Expo Go, since "localhost" on the
# phone means the phone itself, not your dev machine.
EXPO_PUBLIC_VITALS_API_URL="http://localhost:4000"

# The demo garden's id, printed by `npx prisma db seed` in vitals/backend.
# The app has nothing to show without this set.
EXPO_PUBLIC_VITALS_DEMO_GARDEN_ID=""
