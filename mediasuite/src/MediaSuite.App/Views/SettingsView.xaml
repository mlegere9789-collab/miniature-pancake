<UserControl x:Class="MediaSuite.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MediaSuite.App.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,24">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{DynamicResource Text.Display}" />
            <TextBlock Text="Changes apply immediately and are saved as you make them."
                       Style="{DynamicResource Text.Secondary}"
                       Margin="0,6,0,0" />

            <!-- Appearance -->
            <Border Style="{DynamicResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{DynamicResource Text.Heading}" />
                    <TextBlock Text="Theme" Style="{DynamicResource Text.Secondary}" Margin="0,10,0,4" />
                    <RadioButton Content="Follow Windows setting"
                                 GroupName="Theme"
                                 Style="{DynamicResource Input.Radio}"
                                 IsChecked="{Binding IsThemeSystem, Mode=TwoWay}" />
                    <RadioButton Content="Light"
                                 GroupName="Theme"
                                 Style="{DynamicResource Input.Radio}"
                                 IsChecked="{Binding IsThemeLight, Mode=TwoWay}" />
                    <RadioButton Content="Dark"
                                 GroupName="Theme"
                                 Style="{DynamicResource Input.Radio}"
                                 IsChecked="{Binding IsThemeDark, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Saving -->
            <Border Style="{DynamicResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Saving" Style="{DynamicResource Text.Heading}" />
                    <TextBlock Text="Default save folder. Any job can override it, and Google Drive upload stays a per-job choice."
                               Style="{DynamicResource Text.Secondary}"
                               Margin="0,6,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{DynamicResource Input.Text}" />
                        <Button Grid.Column="1"
                                Content="Browse…"
                                Style="{DynamicResource Button.Secondary}"
                                Command="{Binding BrowseOutputDirectoryCommand}"
                                Margin="8,0,0,0" />
                    </Grid>
                    <CheckBox Content="Recreate the source folder structure for batches"
                              Style="{DynamicResource Input.Check}"
                              IsChecked="{Binding PreserveFolderStructure, Mode=TwoWay}"
                              Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Performance -->
            <Border Style="{DynamicResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Performance" Style="{DynamicResource Text.Heading}" />
                    <TextBlock Text="How many jobs run at the same time. Defaults to this machine's core count."
                               Style="{DynamicResource Text.Secondary}"
                               Margin="0,6,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="1"
                                Maximum="{Binding MaxConcurrencyLimit, Mode=OneWay}"
                                Value="{Binding MaxConcurrentJobs, Mode=TwoWay}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ConcurrencyHint}"
                                   Style="{DynamicResource Text.Secondary}"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </Grid>

                    <TextBlock Text="Temporary files"
                               Style="{DynamicResource Text.Secondary}"
                               Margin="0,16,0,4" />
                    <CheckBox Content="Use a custom working folder (point this at a RAM disk for maximum speed)"
                              Style="{DynamicResource Input.Check}"
                              IsChecked="{Binding UseCustomTempDirectory, Mode=TwoWay}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TempDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{DynamicResource Input.Text}"
                                 IsEnabled="{Binding UseCustomTempDirectory}" />
                        <Button Grid.Column="1"
                                Content="Browse…"
                                Style="{DynamicResource Button.Secondary}"
                                Command="{Binding BrowseTempDirectoryCommand}"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Updates and integrations -->
            <Border Style="{DynamicResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Updates and integrations" Style="{DynamicResource Text.Heading}" />
                    <CheckBox Content="Check for updates when the app starts (never installs anything on its own)"
                              Style="{DynamicResource Input.Check}"
                              IsChecked="{Binding CheckForUpdatesOnLaunch, Mode=TwoWay}"
                              Margin="0,10,0,0" />
                    <CheckBox Content="Enable saving to Google Drive"
                              Style="{DynamicResource Input.Check}"
                              IsChecked="{Binding GoogleDriveEnabled, Mode=TwoWay}"
                              Margin="0,10,0,0" />

                    <StackPanel Visibility="{Binding GoogleDriveEnabled, Converter={StaticResource BoolToVisibility}}"
                                Margin="24,10,0,0">
                        <TextBlock Text="Off by default and never uploads on its own — each job still has its own upload checkbox."
                                   Style="{DynamicResource Text.Caption}" />

                        <TextBlock Text="OAuth client file" Style="{DynamicResource Text.Caption}" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding GoogleDriveCredentialsPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{DynamicResource Input.Text}" />
                            <Button Grid.Column="1"
                                    Content="Browse…"
                                    Style="{DynamicResource Button.Secondary}"
                                    Command="{Binding BrowseGoogleDriveCredentialsCommand}"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="Drive access has to come from a Google Cloud project you own — create one at console.cloud.google.com, enable the Drive API, add an OAuth client of type &quot;Desktop app&quot;, and download its JSON here."
                                   Style="{DynamicResource Text.Caption}"
                                   Margin="0,4,0,0" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding GoogleDriveStatus}" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Sign in"
                                    Style="{DynamicResource Button.Secondary}"
                                    Command="{Binding SignInToGoogleDriveCommand}"
                                    Visibility="{Binding IsSignedInToGoogleDrive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    Margin="8,0,0,0" />
                            <Button Grid.Column="1"
                                    Content="Sign out"
                                    Style="{DynamicResource Button.Secondary}"
                                    Command="{Binding SignOutOfGoogleDriveCommand}"
                                    Visibility="{Binding IsSignedInToGoogleDrive, Converter={StaticResource BoolToVisibility}}"
                                    Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bundled tools -->
            <Border Style="{DynamicResource Card}" Margin="0,16,0,24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bundled tools" Style="{DynamicResource Text.Heading}" />
                            <TextBlock Text="{Binding ToolSummary}"
                                       Style="{DynamicResource Text.Secondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Re-scan"
                                Style="{DynamicResource Button.Secondary}"
                                Command="{Binding RefreshToolsCommand}"
                                VerticalAlignment="Top" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ToolsDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{DynamicResource Input.Text}" />
                        <Button Grid.Column="1"
                                Content="Browse…"
                                Style="{DynamicResource Button.Secondary}"
                                Command="{Binding BrowseToolsDirectoryCommand}"
                                Margin="8,0,0,0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Tools}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{DynamicResource Text.Body}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Purpose}"
                                                       Style="{DynamicResource Text.Secondary}"
                                                       FontSize="12"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Path}"
                                                       Style="{DynamicResource Text.Caption}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0">
                                            <!-- Style set here rather than as an attribute so the
                                                 found/missing colour can come from a DataTrigger. -->
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
