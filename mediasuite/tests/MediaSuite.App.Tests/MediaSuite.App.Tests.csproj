<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches MediaSuite.App's own TargetFramework exactly (net8.0-windows) so the
         ProjectReference below is an unambiguous, same-TFM reference — nothing here
         actually touches a WPF/Windows-only API (SingleInstanceGuard is plain OS-primitive
         code), but a mismatched net8.0 test TFM referencing a net8.0-windows app project is
         the kind of thing that can go either way depending on SDK version, not worth risking. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MediaSuite.App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MediaSuite.App\MediaSuite.App.csproj" />
  </ItemGroup>

</Project>
