    "FACETRES" "FIELDEVAL" "FILEDIA" "FILLETRAD" "FILLMODE" "FRONTZ" "GRIDMODE" "HPNAME" "HPSCALE" "INSBASE" "INSUNITS" "INSUNITSDEFSOURCE" "INSUNITSDEFTARGET" "ISOLINES"
    "LASTANGLE" "LASTPOINT" "LAYOUTREGENCTL" "LENSLENGTH" "LIMCHECK" "LIMMAX" "LIMMIN" "LOCALE" "LOGFILEMODE" "LTSCALE" "LUNITS" "LUPREC" "MAXACTVP" "MEASUREMENT"
    "MENUNAME" "MIRRTEXT" "MODEMACRO" "ORTHOMODE" "OSMODE" "PDMODE" "PDSIZE" "PELLIPSE" "PICKBOX" "PLATFORM" "PLINEGEN" "PLINEWID" "PRODUCT" "PROJECTNAME" "PSLTSCALE"
    "REGENMODE" "RELEASE" "SAVEFILE" "SHADEDGE" "SHADEDIF" "SNAPMODE" "SOLIDCHECK" "SPLFRAME" "SPLINESEGS" "SPLINETYPE" "SURFTAB1" "SURFTAB2" "SURFTYPE" "SURFU" "SURFV"
    "TEXTSIZE" "TEXTSTYLE" "THICKNESS" "TILEMODE" "TOOLTIPS" "TRIMMODE" "UCSNAME" "UNITMODE" "USERI1" "VISRETAIN" "WORLDUCS" "XREFCTL" "3DOSMODE" "BACKGROUNDPLOT"
    "VSCURRENT" "VIEWMODE" "TARGET" "VIEWDIR" "VSMAX" "VSMIN" "NAVVCUBEDISPLAY" "SELECTIONPREVIEW" "MESHTYPE" "SURFACEASSOCIATIVITY" "SOLIDHIST" "SHOWHIST" "DELOBJ"))
(defun d8:sysvars (/ out v)
  (setq out nil)
  (foreach n *d8-sysvars*
    (setq v (vl-catch-all-apply 'getvar (list n)))
    (setq out (cons (cons n (if (vl-catch-all-error-p v) "n/a" (if (listp v) (d8:arr v) v))) out)))
  (d8:obj (reverse out)))
(defun d8:lisp-commands (/ out)
  (setq out nil)
  (foreach a (atoms-family 1) (if (and (= (strlen a) (strlen a)) (wcmatch (strcase a) "C:*")) (setq out (cons a out))))
  (d8:arr (vl-sort out '<)))

;;; ---------------------------------------------------------------- main
(defun c:D8REF (/ t0 res name fn r saved out-env now manifest ss)
  (setq *d8-acad* (vlax-get-acad-object) *d8-doc* (vla-get-ActiveDocument *d8-acad*) *d8-ms* (vla-get-ModelSpace *d8-doc*))
  (if (ssget "_X") (progn (princ "\nThe drawing is not empty. Use QNEW and run D8REF again. Nothing was changed.") (exit)))
  (setq out-env (getenv "D8_REF_OUT"))
  (setq *d8-out* (vl-string-translate "\\" "/"
                   (if (and out-env (/= out-env "")) out-env
                       (getstring T "\nOutput folder (empty folder recommended): "))))
  (if (not (d8:mkdirs *d8-out*)) (progn (princ "\nCould not create the output folder.") (exit)))
  (setq saved (list (getvar "FILEDIA") (getvar "CMDECHO") (getvar "EXPERT")))
  (setvar "FILEDIA" 0) (setvar "CMDECHO" 0) (setvar "EXPERT" 5)
  (vla-StartUndoMark *d8-doc*)
  (setq res nil t0 (getvar "DATE"))
  (foreach s *d8-scenarios*
    (setq name (car s) fn (cdr s))
    (setq r (vl-catch-all-apply fn nil))
    (setq res (cons (cons name
                          (if (vl-catch-all-error-p r)
                              (d8:obj (list (cons "status" "error") (cons "error" (vl-catch-all-error-message r))))
                              (d8:obj (list (cons "status" "ok") (cons "values" (d8:obj r))))))
                    res))
    ;; clean slate for the next scenario
    (vlax-for o *d8-ms* (vl-catch-all-apply 'vla-Delete (list o)))
    (while (> (getvar "CMDACTIVE") 0) (command "")))
  (vla-EndUndoMark *d8-doc*)
  (d8:write "measurements.json" (d8:js (d8:obj (reverse res))))
  (d8:write "commands.json" (d8:js (d8:obj (list (cons "menus" (vl-catch-all-apply-val '(lambda () (d8:arr (d8:menus)))))
                                                (cons "toolbars" (vl-catch-all-apply-val '(lambda () (d8:arr (d8:toolbars)))))
                                                (cons "lisp_defined_commands" (d8:lisp-commands))
                                                (cons "system_variables" (d8:sysvars))
                                                (cons "note" "AutoCAD has no single call that lists all built-in commands; menus and toolbars are enumerated through ActiveX. The owner also exports the command alias file and the CUIx by hand (README).")))))
  (setq manifest
    (d8:obj (list (cons "harness" "dino8-reference-autocad") (cons "harness_version" *d8-version*) (cons "tested_against_real_application" nil)
                  (cons "program" "AutoCAD") (cons "acadver" (getvar "ACADVER")) (cons "product" (getvar "PRODUCT")) (cons "release" (getvar "RELEASE"))
                  (cons "platform" (getvar "PLATFORM")) (cons "locale" (getvar "LOCALE")) (cons "com_version" (vla-get-Version *d8-acad*))
                  (cons "julian_date" (getvar "DATE"))
                  (cons "settings" (d8:obj (list (cons "insunits" (getvar "INSUNITS")) (cons "measurement" (getvar "MEASUREMENT")) (cons "lunits" (getvar "LUNITS"))
                                                 (cons "luprec" (getvar "LUPREC")) (cons "isolines" (getvar "ISOLINES")) (cons "facetres" (getvar "FACETRES"))
                                                 (cons "filedia_restored_to" (car saved)))))
                  (cons "scenario_count" (length *d8-scenarios*)))))
  (d8:write "manifest.json" (d8:js manifest))
  (setvar "FILEDIA" (car saved)) (setvar "CMDECHO" (cadr saved)) (setvar "EXPERT" (caddr saved))
  (princ (strcat "\nDino 8 reference run finished. Output: " *d8-out*))
  (princ))
(princ "\nDino 8 reference harness loaded. Type D8REF in an EMPTY drawing (QNEW).")
(princ)
