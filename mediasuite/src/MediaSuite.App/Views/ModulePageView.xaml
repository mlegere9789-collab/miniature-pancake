<UserControl x:Class="MediaSuite.App.Views.ModulePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MediaSuite.App.Controls"
             xmlns:converters="clr-namespace:MediaSuite.App.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,24">
        <StackPanel>

            <TextBlock Text="{Binding Headline}" Style="{DynamicResource Text.Display}" />
            <TextBlock Text="{Binding Description}"
                       Style="{DynamicResource Text.Secondary}"
                       MaxWidth="820"
                       HorizontalAlignment="Left"
                       Margin="0,6,0,0" />

            <controls:DropZone Prompt="{Binding DropPrompt}"
                               Hint="{Binding DropHint}"
                               FilesDroppedCommand="{Binding AddFilesCommand}"
                               Margin="0,20,0,0" />

            <TextBlock Text="{Binding LastLaunchSummary}"
                       Style="{DynamicResource Text.Secondary}"
                       Margin="0,12,0,0"
                       Visibility="{Binding HasLaunchSummary, Converter={StaticResource BoolToVisibility}}" />

            <!-- Staged files and the settings the job will run with -->
            <Border Style="{DynamicResource Card}"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Staged files" Style="{DynamicResource Text.Heading}" />
                            <TextBlock Text="{Binding StagedSummary}"
                                       Style="{DynamicResource Text.Secondary}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Clear"
                                Style="{DynamicResource Button.Secondary}"
                                Command="{Binding ClearFilesCommand}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <ListBox ItemsSource="{Binding StagedFiles}"
                             Style="{DynamicResource FileList}"
                             MaxHeight="180"
                             Margin="0,12,0,0" />

                    <Separator Margin="0,14,0,10" Background="{DynamicResource Brush.Border}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Tool" Style="{DynamicResource Text.Caption}" />
                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding ReadyFeatures}"
                                  SelectedItem="{Binding SelectedFeature, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Margin="0,4,0,0" />

                        <TextBlock Grid.Column="2" Text="Output format" Style="{DynamicResource Text.Caption}" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="2"
                                  ItemsSource="{Binding OutputFormats}"
                                  SelectedItem="{Binding SelectedOutputFormat, Mode=TwoWay}"
                                  Margin="0,4,0,0" />

                        <TextBlock Grid.Column="4" Text="Quality" Style="{DynamicResource Text.Caption}" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="4"
                                  ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  Margin="0,4,0,0" />
                    </Grid>

                    <TextBlock Text="Save to" Style="{DynamicResource Text.Caption}" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{DynamicResource Input.Text}" />
                        <Button Grid.Column="1"
                                Content="Browse…"
                                Style="{DynamicResource Button.Secondary}"
                                Command="{Binding BrowseOutputDirectoryCommand}"
                                Margin="8,0,0,0" />
                        <Button Grid.Column="2"
                                Content="Start"
                                Style="{DynamicResource Button.Primary}"
                                Command="{Binding StartCommand}"
                                Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding StartHint}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- What this page offers, straight from the feature catalogue -->
            <ItemsControl ItemsSource="{Binding FeatureGroups}" Margin="0,24,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.Heading}" />
                                <TextBlock Text="{Binding CountLabel}"
                                           Style="{DynamicResource Text.Caption}"
                                           VerticalAlignment="Center"
                                           Margin="10,2,0,0" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Features}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="268"
                                                Padding="14"
                                                Margin="0,0,12,12"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                Background="{DynamicResource Brush.Surface}"
                                                BorderBrush="{DynamicResource Brush.Border}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <!-- Tools without an engine yet read as
                                                             pending rather than broken. -->
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.55" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{DynamicResource Text.Body}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{DynamicResource Text.Secondary}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Margin="0,10,0,0"
                                                           FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
