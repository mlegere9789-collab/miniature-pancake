{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dino 8 Parity Register row",
  "type": "object",
  "required": [
    "id",
    "program",
    "statement",
    "source",
    "target",
    "factory",
    "domain",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^D8-[A-Z0-9]{2,8}-[A-Z0-9]{2,8}-[0-9]{4}$"
    },
    "program": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "rhino",
          "grasshopper",
          "archicad",
          "sketchup",
          "forma",
          "revit",
          "blender",
          "autocad"
        ]
      }
    },
    "statement": {
      "type": "string",
      "minLength": 10
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "ref",
        "doc"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "command",
            "operator",
            "node",
            "component",
            "tool",
            "feature",
            "setting",
            "modifier",
            "constraint",
            "editor"
          ]
        },
        "ref": {
          "type": "string"
        },
        "doc": {
          "type": "string"
        }
      }
    },
    "tier_now": {
      "enum": [
        "None",
        "Basic",
        "Partial",
        "Strong",
        "Best"
      ],
      "default": "None"
    },
    "target": {
      "enum": [
        "Strong",
        "Best"
      ]
    },
    "superiority": {
      "type": "string"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "corpus": {
            "type": "string"
          },
          "tolerance": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "budget_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "links": {
      "type": "object",
      "properties": {
        "pain_points": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "wishes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "factory": {
      "enum": [
        "kernel-geometry",
        "mesh-subd-sculpt",
        "direct-modeling",
        "flow",
        "bim-arch",
        "bim-struct-mep",
        "drafting-docs",
        "cad-2d",
        "render-anim",
        "simulation",
        "analysis-site",
        "interop-migration",
        "collab-cloud",
        "ux-access-i18n",
        "scripting-api-ai",
        "performance"
      ]
    },
    "domain": {
      "type": "string"
    },
    "alias_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "open",
        "in_progress",
        "verified"
      ]
    },
    "evidence": {
      "description": "Written by CI only. null until the row is counted. run_id and commit are required once counted; spec_sha seals the acceptance list at credit time.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "run_id",
        "commit"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "task": {
          "type": "string"
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spec_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recorded_at": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "wave": {
      "description": "Wave (plan 6.2) in which the row is planned to be completed; rows without it are reported as 'unassigned'.",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "superiority_tests": {
      "description": "Test ids that prove the superiority statement (Best tier). A row reaches Best only when all of them are ok in evidence.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
